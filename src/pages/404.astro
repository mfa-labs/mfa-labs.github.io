---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Page Not Found"
  description="The page you are looking for does not exist."
  lang="en"
  noindex
>
  <Nav lang="en" />

  <main class="flex-grow w-full py-section-gap">
    <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop text-center">
      <p class="font-mono text-xs uppercase tracking-widest mb-4" style="color: var(--color-secondary);">
        Error 404
      </p>
      <h1
        class="font-display text-[48px] md:text-[64px] leading-tight font-semibold mb-4"
        style="color: var(--color-primary);"
      >
        Page Not Found
      </h1>
      <p class="font-body text-sm leading-relaxed mb-2" style="color: var(--color-on-surface-variant);">
        The link may have changed or been mistyped.
      </p>
      <p class="font-body text-sm leading-relaxed mb-12" style="color: var(--color-on-surface-variant);">
        Halaman tidak ditemukan — tautannya mungkin sudah berubah atau salah ketik.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/" class="btn-primary px-8 py-3.5">Back to Home</a>
        <a href="/id/" class="btn-secondary px-8 py-3.5">Beranda (ID)</a>
        <a href="/blog/" class="btn-secondary px-8 py-3.5">Read the Blog</a>
      </div>
    </div>
  </main>

  <Footer lang="en" />
</Layout>
