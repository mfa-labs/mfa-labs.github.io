---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Muhammad Fadhil Al Amal',
  alternateName: 'Fadhil Al Amal',
  jobTitle: 'AI & Software Engineer',
  description: 'AI & Software Engineer | NLP Researcher | Health Information Systems Developer. Experiencing in secure healthcare ecosystems, database performance optimization, and regional language processing models.',
  url: 'https://mfa-labs.github.io',
  image: 'https://mfa-labs.github.io/cropped_circle_image.png',
  sameAs: [
    'https://www.linkedin.com/in/muhammad-fadhil-al-amal/',
    'https://scholar.google.com/citations?user=1pAz6xgAAAAJ&hl=id',
    'http://github.com/mfa-labs',
  ],
  knowsAbout: ['Software Engineering', 'Natural Language Processing', 'Healthcare IT', 'Machine Learning', 'SaaS'],
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'University of Syiah Kuala' },
};
---

<Layout title="Muhammad Fadhil Al Amal" description="AI & Software Engineer | NLP Researcher | Health Information Systems Developer" jsonLd={jsonLd}>
  <Nav />

  <main class="flex-grow w-full">

    <!-- Hero -->
    <section id="about" class="w-full max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-section-gap flex flex-col md:flex-row items-center justify-between gap-12 relative overflow-hidden">
      <div class="absolute top-0 right-0 -z-10 w-full h-full pointer-events-none opacity-20" style="background: radial-gradient(ellipse at top right, var(--color-secondary-container), transparent 70%);"></div>
      <div class="flex-1 flex flex-col items-start text-left z-10 max-w-3xl">
        <div class="mb-4 inline-flex items-center gap-2 px-3 py-1 rounded-full" style="background: var(--color-surface-container); border: 1px solid var(--color-outline-variant);">
          <span class="w-2 h-2 rounded-full bg-secondary"></span>
          <span class="font-mono text-xs" style="color: var(--color-on-surface-variant);">Available for Research Collaborations</span>
        </div>
        <h1 class="font-display text-[48px] leading-[1.1] tracking-tight font-semibold md:text-[64px] md:leading-[1.05] mb-6" style="color: var(--color-primary);">
          Engineering Scalable SaaS.<br />
          <span style="color: var(--color-on-surface-variant);">Researching Advanced NLP.</span>
        </h1>
        <p class="font-body text-lg leading-7 mb-10 max-w-2xl" style="color: var(--color-on-surface-variant);">
          <strong>5+ years</strong> building &amp; maintaining a healthcare SaaS platform at <strong>Kelola.net</strong> — CodeIgniter 3 (PHP MVC), MySQL 8.0, REST API, Docker. AI &amp; NLP Researcher focused on regional language processing and agentic intelligence.
        </p>
        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4 w-full sm:w-auto">
          <a href="#engineering" class="w-full sm:w-auto btn-primary px-8 py-4">View Industry Case Studies</a>
          <a href="#publications" class="w-full sm:w-auto btn-secondary px-8 py-4 group">
            Read Scientific Publications
            <span class="material-symbols-outlined ml-2 text-lg group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform">arrow_outward</span>
          </a>
        </div>
        <div class="mt-12 pt-8 border-t w-full flex flex-wrap gap-3" style="border-color: color-mix(in srgb, var(--color-outline-variant) 50%, transparent);">
          <span class="tag-green">PHP</span>
          <span class="tag-green">CodeIgniter</span>
          <span class="tag-green">MySQL</span>
          <span class="tag-green">Docker</span>
          <span class="tag-green">REST API</span>
          <span class="tag-green">JavaScript</span>
        </div>
      </div>
      <div class="flex-1 w-full relative min-h-[400px] hidden lg:block">
        <img src="/cropped_circle_image.png" alt="Muhammad Fadhil Al Amal" class="w-full h-full object-cover rounded-xl shadow-ambient grayscale hover:grayscale-0 transition-all duration-700" />
      </div>
    </section>

    <!-- Skills -->
    <section style="background: var(--color-surface-container-low);" class="py-section-gap">
      <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
        <div class="mb-12">
          <h2 class="section-title">Core Skills Matrix</h2>
          <p class="section-desc">Specialized technical expertise across the full software development lifecycle.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {[
            { icon: 'dns', title: 'Backend & Infra', items: ['PHP (CodeIgniter 3 MVC)', 'MySQL 8.0', 'REST API & JSON Integration', 'Docker & VPS Management', 'Redis Session & Cache', 'Bootstrap 4 UI'] },
            { icon: 'psychology', title: 'AI & Machine Learning', items: ['Natural Language Processing', 'Sentiment Analysis', 'LLM (Ollama, Hugging Face, Qwen)', 'Scikit-learn', 'TensorFlow'] },
            { icon: 'medical_services', title: 'Healthcare Tech', items: ['SATUSEHAT Integration (FHIR)', 'Multi-Tenant SaaS Platforms', 'Clinical EMR & Workflow Systems', 'Financial & Billing Systems', 'Healthcare DevOps'] },
          ].map((skill) => (
            <div class="p-6 border rounded-xl shadow-sm" style="background: var(--color-surface-container-lowest); border-color: var(--color-outline-variant);">
              <div class="flex items-center gap-3 mb-4">
                <span class="material-symbols-outlined" style="color: var(--color-secondary);">{skill.icon}</span>
                <h3 class="font-display text-xl" style="color: var(--color-primary);">{skill.title}</h3>
              </div>
              <ul class="space-y-2" style="color: var(--color-on-surface-variant); font-family: var(--font-body);">
                {skill.items.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Engineering -->
    <section id="engineering" class="bg-background py-section-gap" style="background: var(--color-surface);">
      <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
        <div class="mb-12">
          <h2 class="section-title">Enterprise Software Engineering</h2>
          <span class="tag-green-pill inline-flex items-center gap-2 px-3 py-1">
            <span class="font-display text-xs font-medium">5+ Years Software Engineer at Kelola.net — SaaS Manajemen Klinik (2021–2026)</span>
          </span>
          <p class="section-desc mt-4">Full-stack contributions across <strong>9 major workstreams</strong> — <strong>646 commits</strong>, 10.252 files touched, 204 controller files, 36 models, 646 views, serving hundreds of clinics across Indonesia.</p>
        </div>

        <!-- Git Stats Bar -->
        <div class="mb-12 grid grid-cols-2 md:grid-cols-6 gap-4">
          <div class="border rounded-xl p-4 text-center" style="background: var(--color-surface-container-lowest); border-color: var(--color-outline-variant);">
            <div class="font-display text-2xl font-bold" style="color: var(--color-secondary);">646</div>
            <div class="text-xs mt-1" style="color: var(--color-on-surface-variant);">Total Commits</div>
          </div>
          <div class="border rounded-xl p-4 text-center" style="background: var(--color-surface-container-lowest); border-color: var(--color-outline-variant);">
            <div class="font-display text-2xl font-bold" style="color: var(--color-secondary);">444</div>
            <div class="text-xs mt-1" style="color: var(--color-on-surface-variant);">Non-Merge Commits</div>
          </div>
          <div class="border rounded-xl p-4 text-center" style="background: var(--color-surface-container-lowest); border-color: var(--color-outline-variant);">
            <div class="font-display text-2xl font-bold" style="color: var(--color-secondary);">10.252</div>
            <div class="text-xs mt-1" style="color: var(--color-on-surface-variant);">Files Touched</div>
          </div>
          <div class="border rounded-xl p-4 text-center" style="background: var(--color-surface-container-lowest); border-color: var(--color-outline-variant);">
            <div class="font-display text-2xl font-bold" style="color: var(--color-secondary);">204</div>
            <div class="text-xs mt-1" style="color: var(--color-on-surface-variant);">Controllers</div>
          </div>
          <div class="border rounded-xl p-4 text-center" style="background: var(--color-surface-container-lowest); border-color: var(--color-outline-variant);">
            <div class="font-display text-2xl font-bold" style="color: var(--color-secondary);">36</div>
            <div class="text-xs mt-1" style="color: var(--color-on-surface-variant);">Models</div>
          </div>
          <div class="border rounded-xl p-4 text-center" style="background: var(--color-surface-container-lowest); border-color: var(--color-outline-variant);">
            <div class="font-display text-2xl font-bold" style="color: var(--color-secondary);">7</div>
            <div class="text-xs mt-1" style="color: var(--color-on-surface-variant);">DB Migrations</div>
          </div>
        </div>

        <!-- Yearly Timeline -->
        <div class="mb-12 border rounded-xl p-6" style="background: var(--color-surface-container-lowest); border-color: var(--color-outline-variant);">
          <h3 class="font-display text-lg font-semibold mb-4" style="color: var(--color-primary);">Commit Activity by Year</h3>
          <div class="flex flex-col md:flex-row gap-4">
            {[
              { year: '2021', commits: 125, focus: 'Foundation: WA notif, auth/OTP, laporan keuangan, booking, dashboard' },
              { year: '2022', commits: 40, focus: 'Laporan klinik, WA API, fullcalendar, tarif, dashboard per role' },
              { year: '2023', commits: 84, focus: 'SATUSEHAT integration (IHS, encounter, SDMK), server-side DataTable' },
              { year: '2024', commits: 104, focus: 'PHP 8.1 migrasi, Dompdf upgrade, ICD-9 mapping, SATUSEHAT hardening' },
              { year: '2025', commits: 61, focus: 'DiamondDC klinik bersama, laporan dinkes, ICD-9 checkout, bug fixing' },
              { year: '2026', commits: 30, focus: 'CRM module + model, Docker setup, WA template engine, gaji pokok' },
            ].map((y) => (
              <div class="flex-1 border-l md:border-l-0 md:border-t-2 p-3" style="border-color: var(--color-secondary);">
                <div class="font-display text-lg font-bold" style="color: var(--color-secondary);">{y.year}</div>
                <div class="text-lg font-bold" style="color: var(--color-primary);">{y.commits}</div>
                <div class="text-xs mt-1" style="color: var(--color-on-surface-variant);">{y.focus}</div>
              </div>
            ))}
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {[
            { tag: 'Healthcare Interoperability / API Integration · ~34 commits · Aug 2023–May 2025', title: 'SATUSEHAT Integration — Platform Data Kesehatan Nasional', link: '/portfolio/satusehat-integration', desc: "Integrated the clinic system with SATUSEHAT (Satusehat.php, 377 lines, 2 models), the Indonesian Ministry of Health's national health data exchange platform — separate database (newsatusehat) for logs and tokens, enabling hundreds of clinics to submit electronic medical records to the national system.", items: ['REST API client for SATUSEHAT endpoints (auth OAuth2, CRUD pasien, practitioner, organization, location)', 'Patient IHS lookup & registration with duplicate detection, no-IHS-not-found handling, error recovery', 'SDMK practitioner (doctor, nurse) verification to national SDMK database', 'Organization & Location — facility and practice room registration via API; configurable staging/production environment', 'RME encounter submission with ICD-10 diagnosis and ICD-9 procedures', 'ICD-9 procedure code mapping for clinic actions; checkout dokter with ICD-9 codes', 'Logging & error tracking with dedicated log tables, per-transaction error detail, resend queue for failed submissions', 'Configurable SATUSEHAT key per tenant from admin panel (not hardcoded)', 'Menu per role — SATUSEHAT available in clinic, doctor, admin dashboards with different context'], tags: ['REST API', 'OAuth2', 'JSON', 'ICD-10', 'ICD-9', 'FHIR'] },
            { tag: 'Automation System / CRM · ~28 commits · May 2021–Jul 2026', title: 'WhatsApp Notification & CRM System', desc: 'End-to-end WhatsApp notification system (WaNotif.php, Mainlib.php 2.488 lines) for appointment reminders, birthday greetings, OTP login, and invoice delivery — spanning legacy cron architecture (WaNotif.php, 2021–2025) and a modern CRM module (2026).', items: ['Legacy cron-based delivery: H-1 reminders, same-day reminders, birthday greetings, daily clinic reports per doctor', 'CRM module with device management (CRUD via StarSender new API, QR scan display, status polling AJAX, logout)', 'Template engine — 4 trigger types (H-1, Same-Day, Birthday, Invoice) with dynamic variables: {nama}, {hari}, {tanggal}, {jam}, {dokter}, {invoice}, {nominal}', "CRM_model — centralized DB queries: get_device(), upsert_device(), delete_device(), update_device_status(), get_template(), upsert_template(), is_valid_trigger_id()", 'Rate limiting — 8s minimum poll interval per user via session cooldown', 'WhatsApp OTP for two-factor authentication on new device login; device trusted cookie', 'Webhook-based WhatsApp bot for admin commands (Helpme.php)', 'Bulk save ("Simpan Semua") via sequential AJAX; test send to owner number; toggle all without changing content', 'Critical bug fixes: undefined variable on API failure, foreach null, variable scope, empty trigger type, API key duplication'], tags: ['PHP', 'JavaScript', 'WhatsApp API', 'StarSender', 'AJAX', 'CRON'] },
            { tag: 'Performance Engineering / Financial Systems · ~44 commits · Jun 2021–Mar 2025', title: 'Financial Reporting & Jasa Medis System', desc: 'Multi-role financial reporting system with server-side processing, Excel/PDF export, and complex medical fee-splitting (Jasa Medis) calculations across clinic, private practice, owner, and BPJS dashboards.', items: ['Multi-role reports: clinic, private practice, owner, BPJS financial dashboards', 'Jasa Medis fee splitting — per-procedure doctor fee calculation; fixed date-31 edge case in reports', 'Laporan Dinkes (local health dept): SKP doctor reports, ranu (inpatient) reports', 'Owner revenue breakdown — per-clinic income detail for multi-clinic owners', 'Excel (PhpSpreadsheet) & PDF (Dompdf) export with non-technical-readable formatting', 'Server-side DataTable pagination for large transaction tables (daily, monthly, yearly)', 'Custom date range filters across all reports; cancelled patient tracking with created_by'], tags: ['PHP', 'CodeIgniter', 'MySQL', 'PhpSpreadsheet', 'Dompdf'] },
            { tag: 'Clinical Information Systems / EMR · ~42 commits · Jul 2021–Jun 2026', title: 'Medical Records & Clinical Workflow', desc: 'Electronic medical records system for general and dental clinics — including digital odontogram charting, ICD-10/ICD-9 coding, 5-status checkout progression, appointment booking, and multi-clinic record sharing.', items: ['Odontogram digital dental chart for tooth condition charting', 'ICD-10 multi-diagnosis support & ICD-9 procedure code mapping at checkout', '5-status checkout progression tracking for patient visits from start to finish', 'Booking & appointment system for all roles (admin, klinik, pribadi, umum)', 'Combined RM (rekam medis gabungan) for shared clinics; sharing RM across clinic groups', 'General & dental examination workflows with inline billing from RM', 'Bug fix: RM data gigi kosong — handling empty dental data in doctor accounts'], tags: ['PHP', 'CodeIgniter', 'MySQL', 'ICD-10', 'ICD-9', 'Odontogram'] },
            { tag: 'Payment Systems / Billing · ~33 commits · Aug 2021–Mar 2025', title: 'Billing & Kasir System', desc: 'Multi-method payment system with invoice generation, debt/piutang tracking, multi-level discounts, and server-side DataTable processing across all user roles.', items: ['Multi-method payments: cash, transfer, debit/credit card, BPJS, hutang (debt)', 'Multi-level discount system — per-procedure and multi-tier discounts with bug fixes', 'PDF invoice via Dompdf, diagnosis print on invoice, thermal printer support', 'Debt/piutang tracking — payment status monitoring per transaction', 'Server-side DataTable for all roles (admin, clinic, private, general)', 'Consistent Rupiah formatting (no space) across all roles and views', 'Detail pembayaran — nominal paid, payment status, payment method'], tags: ['PHP', 'CodeIgniter', 'MySQL', 'Dompdf'] },
            { tag: 'Legacy Modernization · ~13 commits · Nov–Dec 2024', title: 'PHP 7 → PHP 8 Migration (No Downtime)', desc: 'Migrated the entire platform from PHP 7 to PHP 8.1 without downtime — fixing deprecated functions, type errors, and compatibility issues across every module with manual regression testing.', items: ['Dompdf upgrade from legacy version to 2.0 for PHP 8 compatibility', 'Fixed deprecated functions, type errors, each() removal, null handling across codebase', 'Fixed report calculations (daily, jasmed) affected by stricter PHP 8 type system', 'Fixed PHPMailer compatibility for email invoice delivery', 'Fixed bugs: detail pasien view/edit, add new pasien, pemeriksaan dokter umum flow', 'HTACCESS configuration update for PHP 8.1 settings and security headers', 'Manual regression testing across every module post-migration'], tags: ['PHP', 'CodeIgniter', 'Migration'] },
            { tag: 'System Architecture / Authorization · 12 roles · 2021–2026', title: 'Multi-Tenant & Role-Based Architecture', link: '/portfolio/multi-tenant-role-architecture', desc: 'Multi-tenant architecture with 12 user roles, hash-based data isolation (klinikKey, praktikKey), role-based controller routing, shared clinic groups, and session + OTP auth for device security.', items: ['Data isolation — every query scoped by klinikKey and praktikKey (128-char hash)', '12 roles: Klinik, Dokter, Admin Klinik, Owner, Partner, Super Admin, Praktik Pribadi, Klinik BPJS, Umum, Klinik Umum, Dokter Klinik Umum, Admin Klinik Umum', 'Shared clinic groups — multi-clinic data sharing (Ranu, Densglo, Jasmine, Vialyne, DiamondDC)', 'Klinik bersama — multiple clinics sharing resources with limited scope', 'Auth routing: login → role detection → redirect to role-specific dashboard; session + OTP for new devices', 'CRUD role management for super admin with per-tenant user and access control'], tags: ['PHP', 'CodeIgniter', 'MySQL', 'RBAC', 'Multi-Tenant'] },
            { tag: 'System Administration / Infrastructure · ~33 commits · 2021–2026', title: 'Infrastructure & DevOps', desc: 'Managed production server infrastructure, hosting migration, Docker containerization, and configuration management for a SaaS platform serving hundreds of clinics.', items: ['Docker Compose: PHP 8.1 Apache + MySQL 8.0 + phpMyAdmin; Dockerfile for reproducible dev environment', 'Hosting migration from shared hosting to managed VPS with post-migration validation and live monitoring', 'HTACCESS rewrite rules, PHP settings, security headers; updated for PHP 8.1', 'Redis configuration (unix socket) for session encryption (KelolaPedia@2024 key) and caching', 'Configuration management: database credentials, Redis config, SATUSEHAT environment per tenant', 'Error logging — PHP error log management and log rotation'], tags: ['Linux', 'Docker', 'VPS', 'Redis', 'MySQL'] },
            { tag: 'Database Engineering / Performance · ~18 commits · 2021–2026', title: 'Database & Performance Optimization', desc: 'Query optimization, indexing strategy, and performance tuning for a database managing millions of healthcare transactions across hundreds of clinics.', items: ['Server-side DataTable with pagination, sorting, filtering for large tables (patients, payments, reports)', 'Indexing optimization for appointment and checkout queries', 'Slow query refactoring for reports, patient search, appointment listing', 'Memory leak fix — resolved "gagal menambah pasien baru" caused by memory leak in get_all_pasien', '7 SQL migration files for schema evolution across 5 years'], tags: ['MySQL', 'Query Optimization', 'Indexing', 'Performance'] },
          ].map((proj) => (
            <div class="flex flex-col border rounded-xl overflow-hidden transition-all duration-300 hover:shadow-ambient" style="background: var(--color-surface-container-lowest); border-color: var(--color-outline-variant);">
              <div class="p-6 flex-grow">
                <span class="tag-project mb-4">{proj.tag}</span>
                <h3 class="font-display text-xl mb-3" style="color: var(--color-primary);">{proj.title}</h3>
                <p class="mb-4" style="color: var(--color-on-surface-variant); font-family: var(--font-body);">{proj.desc}</p>
                <ul class="space-y-1 text-sm list-disc pl-4 mb-4" style="color: var(--color-on-surface-variant); font-family: var(--font-body);">
                  {proj.items.map((item) => <li>{item}</li>)}
                </ul>
                {proj.link && <a href={proj.link} class="link-arrow text-sm mt-2">Baca artikel teknis →</a>}
              </div>
              <div class="px-6 py-4 border-t flex flex-wrap gap-2" style="border-color: color-mix(in srgb, var(--color-outline-variant) 50%, transparent);">
                {proj.tags.map((t) => <span class="tag-eng">{t}</span>)}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Research -->
    <section id="research" class="py-section-gap border-t" style="background: var(--color-surface-container-lowest); border-color: var(--color-outline-variant);">
      <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
        <div class="mb-12">
          <h2 class="section-title">AI &amp; Natural Language Processing Research</h2>
          <p class="section-desc">Advancing regional language processing and agentic intelligence through rigorous academic inquiry.</p>
        </div>
        <div class="mb-16">
          <h3 class="font-display text-xl mb-6" style="color: var(--color-primary);">Research Projects</h3>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {[
              { title: 'Sentiment Analysis Bahasa Aceh', desc: 'NLP research for sentiment classification on Acehnese regional language texts.', tags: ['Python', 'Scikit-learn', 'BERT', 'IndoBERT', 'Qwen'] },
              { title: 'Hybrid Model for Regional Language Classification', desc: 'Machine Learning Research developing hybrid architectures for regional languages. Published in an international proceeding.', tags: ['ML Research', 'Deep Learning'] },
              { title: 'Agentic AI Research', desc: 'Research on Generative AI and LLMs using multi-step reasoning workflows and self-refinement pipelines.', tags: ['Qwen', 'Ollama', 'Agentic AI'] },
            ].map((r) => (
              <div class="border rounded-xl p-6 flex flex-col" style="background: var(--color-surface-container-low); border-color: var(--color-outline-variant);">
                <h4 class="font-display text-xl mb-2" style="color: var(--color-primary);">{r.title}</h4>
                <p class="text-sm mb-6 flex-grow" style="color: var(--color-on-surface-variant); font-family: var(--font-body);">{r.desc}</p>
                <div class="flex flex-wrap gap-2">
                  {r.tags.map((t) => <span class="tag-research">{t}</span>)}
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Publications -->
        <div id="publications">
          <h3 class="font-display text-xl mb-6" style="color: var(--color-primary);">Scientific Publications</h3>
          <div class="border rounded-xl overflow-hidden" style="background: var(--color-surface-container-low); border-color: var(--color-outline-variant);">
            <div class="p-6 flex flex-col md:flex-row md:items-center justify-between gap-4 border-b last:border-b-0" style="border-color: color-mix(in srgb, var(--color-outline-variant) 50%, transparent);">
              <div class="flex items-start gap-4">
                <span class="material-symbols-outlined mt-1" style="color: var(--color-on-surface-variant);">description</span>
                <div>
                  <h4 class="font-body text-lg font-medium" style="color: var(--color-primary);">Hybrid Transformer-RNN Model for Classification of Indonesian Regional Language</h4>
                  <p class="text-sm" style="color: var(--color-on-surface-variant);">Published in 2025 International Conference on ICT for Smart Society • 2025</p>
                </div>
              </div>
              <div class="flex items-center gap-4">
                <span class="badge-doi">DOI: 10.1109/ICISS66954.2025.11389462</span>
                <a href="https://ieeexplore.ieee.org/document/11389462/" class="link-arrow text-sm">
                  Read Paper
                  <span class="material-symbols-outlined text-lg ml-1">arrow_outward</span>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Blog Preview -->
    <section id="blog" class="py-20 border-t" style="background: var(--color-surface-container-low); border-color: var(--color-outline-variant);">
      <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
        <div class="mb-12">
          <h2 class="section-title">Insights &amp; Technical Writing</h2>
          <p class="section-desc">Reflections on software engineering, AI architecture, and regional language processing.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <article class="border rounded-xl p-8 hover:shadow-ambient transition-all duration-300" style="background: var(--color-surface-container-lowest); border-color: var(--color-outline-variant);">
            <time class="font-mono text-xs mb-4 block" style="color: var(--color-on-surface-variant);">MAY 14, 2024</time>
            <h3 class="font-display text-xl mb-3" style="color: var(--color-primary);">Optimizing PostgreSQL for High-Volume Healthcare Data</h3>
            <p class="mb-6 line-clamp-2" style="color: var(--color-on-surface-variant); font-family: var(--font-body);">Technical deep dive into indexing strategies and query refactoring for SaaS clinic management systems handling millions of records.</p>
            <a href="/blog/optimizing-postgresql-healthcare-data" class="link-arrow">
              Read Article
              <span class="material-symbols-outlined text-lg ml-1 group-hover:translate-x-1 transition-transform">arrow_outward</span>
            </a>
          </article>
          <article class="border rounded-xl p-8 hover:shadow-ambient transition-all duration-300" style="background: var(--color-surface-container-lowest); border-color: var(--color-outline-variant);">
            <time class="font-mono text-xs mb-4 block" style="color: var(--color-on-surface-variant);">APRIL 02, 2024</time>
