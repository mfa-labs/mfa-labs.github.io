---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const blogPosts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

const courses = (await getCollection('kuliah'))
  .filter((c) => !c.data.draft)
  .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title));

function readingTime(body: string): string {
  const words = body.trim().split(/\s+/).length;
  const minutes = Math.max(1, Math.round(words / 200));
  return `${minutes} min read`;
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Muhammad Fadhil Al Amal',
  alternateName: 'Fadhil Al Amal',
  jobTitle: 'AI & Software Engineer · Informatics Lecturer',
  description: 'AI & Software Engineer | NLP Researcher | Health Information Systems Developer. Experiencing in secure healthcare ecosystems, database performance optimization, and regional language processing models.',
  url: 'https://mfa-labs.github.io/en',
  image: 'https://mfa-labs.github.io/cropped_circle_image.png',
  sameAs: [
    'https://www.linkedin.com/in/muhammad-fadhil-al-amal/',
    'https://scholar.google.com/citations?user=1pAz6xgAAAAJ&hl=id',
    'http://github.com/mfa-labs',
  ],
  knowsAbout: ['Software Engineering', 'Natural Language Processing', 'Healthcare IT', 'Machine Learning', 'SaaS'],
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'University of Syiah Kuala' },
    { '@type': 'CollegeOrUniversity', name: 'UIN Maulana Malik Ibrahim Malang' },
  ],
  worksFor: [
    { '@type': 'Organization', name: 'PT Alfath Teknologi Kreatif' },
    { '@type': 'Organization', name: 'Universitas Ahmad Dahlan Aceh' },
  ],
};

const workshopEvents = [
  {
    '@context': 'https://schema.org',
    '@type': 'Event',
    name: 'Workshop on Digital Administration Management for Secretaries Using AI and Big Data Methods',
    description:
      'Workshop for students of the D3 Secretarial Study Programme, FEB USK: building an AI-powered digital archive prototype.',
    startDate: '2026-09-16',
    eventStatus: 'https://schema.org/EventScheduled',
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
    location: {
      '@type': 'Place',
      name: 'D3 Secretarial Study Programme Hall, Faculty of Economics and Business, Syiah Kuala University',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Banda Aceh',
        addressRegion: 'Aceh',
        addressCountry: 'ID',
      },
    },
    organizer: {
      '@type': 'Organization',
      name: 'D3 Secretarial Study Programme, Faculty of Economics and Business, Syiah Kuala University',
    },
    performer: {
      '@type': 'Person',
      name: 'Muhammad Fadhil Al Amal',
      url: 'https://mfa-labs.github.io/en/',
    },
    image: 'https://mfa-labs.github.io/cropped_circle_image.png',
    inLanguage: 'en',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Event',
    name: 'Archive Innovation and AI Adoption for Study Programme Staff — Even Semester, Academic Year 2025/2026',
    description:
      'Workshop for education staff of the Doctoral Programme in Accounting, FEB USK: building administration tools with Gemini Canvas, no coding required.',
    startDate: '2026-07-07',
    eventStatus: 'https://schema.org/EventScheduled',
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
    location: {
      '@type': 'Place',
      name: 'FEB USK Laboratory Room, Faculty of Economics and Business, Syiah Kuala University',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Banda Aceh',
        addressRegion: 'Aceh',
        addressCountry: 'ID',
      },
    },
    organizer: {
      '@type': 'Organization',
      name: 'Doctoral Programme in Accounting, Faculty of Economics and Business, Syiah Kuala University',
    },
    performer: {
      '@type': 'Person',
      name: 'Muhammad Fadhil Al Amal',
      url: 'https://mfa-labs.github.io/en/',
    },
    image: 'https://mfa-labs.github.io/cropped_circle_image.png',
    inLanguage: 'en',
  },
];
---

<Layout title="Muhammad Fadhil Al Amal — AI Engineer & NLP Researcher" description="AI & Software Engineer in Banda Aceh, Indonesia. 5+ years building healthcare SaaS (CodeIgniter, MySQL, Docker) and researching regional-language NLP." lang="en" alternateUrl="/" jsonLd={[jsonLd, ...workshopEvents]}>
  <Nav />

  <main class="flex-grow w-full">

    <!-- Hero -->
    <section id="about" class="w-full max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-section-gap flex flex-col md:flex-row items-center justify-between gap-12 relative overflow-hidden">
      <div class="absolute top-0 right-0 -z-10 w-full h-full pointer-events-none opacity-20" style="background: radial-gradient(ellipse at top right, var(--color-secondary-container), transparent 70%);"></div>
      <div class="flex-1 flex flex-col items-start text-left z-10 max-w-3xl">
        <div class="mb-4 inline-flex items-center gap-2 px-3 py-1 rounded-full" style="background: var(--color-surface-container); border: 1px solid var(--color-outline-variant);">
          <span class="w-2 h-2 rounded-full bg-secondary"></span>
          <span class="font-mono text-xs" style="color: var(--color-on-surface-variant);">Available for Research Collaborations</span>
        </div>
        <h1 class="font-display text-[48px] leading-[1.1] tracking-tight font-semibold md:text-[64px] md:leading-[1.05] mb-6" style="color: var(--color-primary);">
          Engineering Scalable SaaS.<br />
          <span style="color: var(--color-on-surface-variant);">Researching Advanced NLP.</span>
        </h1>
        <p class="font-body text-lg leading-relaxed mb-10 max-w-2xl" style="color: var(--color-on-surface-variant);">
          <strong>5+ years</strong> building &amp; maintaining a healthcare SaaS platform at <strong>Kelola.net</strong> — CodeIgniter 3 (PHP MVC), MySQL 8.0, REST API, Docker. AI &amp; NLP Researcher focused on regional language processing and agentic intelligence.
        </p>
        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4 w-full sm:w-auto">
          <a href="#engineering" class="w-full sm:w-auto btn-primary px-8 py-4">View Case Studies</a>
          <a href="#publications" class="w-full sm:w-auto btn-secondary px-8 py-4 group">
            Scientific Publications
            <span class="material-symbols-outlined ml-2 text-lg group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform">arrow_outward</span>
          </a>
        </div>
        <div class="mt-12 pt-8 border-t w-full flex flex-wrap gap-3" style="border-color: color-mix(in srgb, var(--color-outline-variant) 50%, transparent);">
          <span class="tag-green">PHP</span>
          <span class="tag-green">CodeIgniter</span>
          <span class="tag-green">MySQL</span>
          <span class="tag-green">Docker</span>
          <span class="tag-green">REST API</span>
          <span class="tag-green">JavaScript</span>
        </div>
      </div>
      <div class="flex-1 w-full relative min-h-[400px] hidden lg:block">
        <img src="/cropped_circle_image.webp" alt="Muhammad Fadhil Al Amal" width="1000" height="1000" class="w-full h-full object-cover rounded-xl shadow-ambient grayscale hover:grayscale-0 transition-all duration-700" />
      </div>
    </section>

    <!-- Skills -->
    <section style="background: var(--color-surface-container-low);" class="py-section-gap">
      <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
        <div class="mb-12">
          <h2 class="section-title">Core Skills Matrix</h2>
          <p class="section-desc">Specialized technical expertise across the full software development lifecycle.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {[
            { icon: 'dns', title: 'Backend & Infrastructure', items: ['PHP (CodeIgniter 3 MVC)', 'MySQL 8.0', 'REST API & JSON Integration', 'Docker & VPS Management', 'Redis Session & Cache', 'Bootstrap 4 UI'] },
            { icon: 'psychology', title: 'AI & Machine Learning', items: ['Natural Language Processing', 'Sentiment Analysis', 'LLM (Ollama, Hugging Face, Qwen)', 'Scikit-learn', 'TensorFlow'] },
            { icon: 'medical_services', title: 'Healthcare Technology', items: ['SATUSEHAT Integration (FHIR)', 'Multi-Tenant SaaS Platforms', 'Clinical EMR & Workflow Systems', 'Financial & Billing Systems', 'Healthcare DevOps'] },
          ].map((skill) => (
            <div class="p-6 border rounded-xl shadow-sm" style="background: var(--color-surface-container-lowest); border-color: var(--color-outline-variant);">
              <div class="flex items-center gap-3 mb-4">
                <span class="material-symbols-outlined" style="color: var(--color-secondary);">{skill.icon}</span>
                <h3 class="font-display text-xl" style="color: var(--color-primary);">{skill.title}</h3>
              </div>
              <ul class="space-y-2" style="color: var(--color-on-surface-variant); font-family: var(--font-body);">
                {skill.items.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Experience & Education -->
    <section id="experience" class="py-section-gap border-t" style="background: var(--color-surface-container-lowest); border-color: var(--color-outline-variant);">
      <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
        <div class="mb-12">
          <h2 class="section-title">Experience &amp; Education</h2>
          <p class="section-desc">A career spanning software engineering and teaching, alongside formal education.</p>
        </div>

        <div class="flex flex-col gap-6 mb-16">
          {[
            {
              role: 'Lecturer — Informatics Study Programme (S1)',
              org: 'Universitas Ahmad Dahlan Aceh',
              period: '2026 – Present',
              type: 'Concurrent with engineering role',
              items: ['Teaching and supervising undergraduate Informatics students'],
            },
            {
              role: 'Software Engineer',
              org: 'PT Alfath Teknologi Kreatif — Kelola.net platform',
              period: 'Apr 2021 – Present',
              type: 'Full-time',
              items: [
                'Designed and built a multi-tenant clinic management SaaS — application architecture, database design, backend, and deployment (PHP, MySQL, PostgreSQL, Docker, REST API)',
                'Reduced critical page load time from 75 seconds to about 5 seconds (93% improvement) through application and database optimization',
                'Led technical implementation and coordinated development tasks across the engineering team, including code review and technical decision-making',
                'Integrated the platform with SATUSEHAT (OAuth2, FHIR, ICD-10/ICD-9) to submit electronic medical records to the Indonesian Ministry of Health',
              ],
            },
            {
              role: 'NLP Engineer',
              org: 'PT Bahasa Kinerja Utama',
              period: 'Jan 2023 – Dec 2023',
              type: 'Contract',
              items: [
                'Built and experimented with deep learning models (Python, PyTorch) for Indonesian conversational text',
                'Developed NLP solutions for automated information extraction from unstructured phone-call transcriptions',
                'Performed preprocessing, cleaning, and transformation of noisy transcription data',
                'Integrated NLP processing into application workflows to turn unstructured text into structured information',
              ],
            },
            {
              role: 'Back End Developer',
              org: 'PT Ina Gata Persada',
              period: 'Feb 2020 – Mar 2021',
              type: 'Full-time',
              items: [
                'Developed backend systems for 4 web applications and 1 mobile application',
                'Designed and implemented backend features, REST APIs, database operations, and business logic',
                'Learned Flutter and shipped a mobile application in under three months',
              ],
            },
            {
              role: 'Web Developer',
              org: 'UIN Maulana Malik Ibrahim Malang',
              period: 'Jan 2019 – Dec 2019',
              type: 'Part-time',
              items: [
                'Built a Single Tuition Fee (UKT) determination information system',
                'Cut data calculation time from 10 minutes to under 2 minutes through query optimization and database normalization',
              ],
            },
          ].map((job) => (
            <div class="border rounded-xl p-6 md:p-8" style="background: var(--color-surface-container-low); border-color: var(--color-outline-variant);">
              <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-2 mb-4">
                <div>
                  <h3 class="font-display text-xl" style="color: var(--color-primary);">{job.role}</h3>
                  <p class="font-mono text-sm" style="color: var(--color-secondary);">{job.org}</p>
                </div>
                <div class="md:text-right shrink-0">
                  <p class="font-mono text-xs" style="color: var(--color-on-surface-variant);">{job.period}</p>
                  <p class="font-mono text-xs" style="color: var(--color-on-surface-variant); opacity: 0.6;">{job.type}</p>
                </div>
              </div>
              <ul class="space-y-1 text-sm list-disc pl-4" style="color: var(--color-on-surface-variant); font-family: var(--font-body);">
                {job.items.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          ))}
        </div>

        <h3 class="font-display text-xl mb-6" style="color: var(--color-primary);">Education</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {[
            { degree: 'Master of Artificial Intelligence', school: 'Syiah Kuala University', period: '2021 – 2023' },
            { degree: 'Bachelor of Informatics', school: 'UIN Maulana Malik Ibrahim Malang', period: '2015 – 2020' },
          ].map((edu) => (
            <div class="border rounded-xl p-6" style="background: var(--color-surface-container-low); border-color: var(--color-outline-variant);">
              <h4 class="font-display text-lg mb-1" style="color: var(--color-primary);">{edu.degree}</h4>
              <p class="font-mono text-sm mb-1" style="color: var(--color-secondary);">{edu.school}</p>
              <p class="font-mono text-xs" style="color: var(--color-on-surface-variant);">{edu.period}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {courses.length > 0 && (
      <section id="teaching" class="py-section-gap border-t" style="background: var(--color-surface-container-low); border-color: var(--color-outline-variant);">
        <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
          <div class="mb-12">
            <h2 class="section-title">Teaching</h2>
            <p class="section-desc">Courses I teach in the Informatics Study Programme (S1), Universitas Ahmad Dahlan Aceh — with topics and materials for each session. Course pages are written in Indonesian.</p>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            {courses.map((course) => (
              <article class="flex flex-col border rounded-xl overflow-hidden transition-all duration-300 hover:shadow-ambient" style="background: var(--color-surface-container-lowest); border-color: var(--color-outline-variant);">
                <div class="p-8 flex-grow flex flex-col">
                  <p class="font-mono text-xs mb-4" style="color: var(--color-secondary);">{course.data.code} · {course.data.credits} SKS{course.data.terms[0] && <> · {course.data.terms[0].label}</>}</p>
                  <h3 class="font-display text-xl font-semibold mb-3 leading-snug" style="color: var(--color-primary);">
                    <a href={`/kuliah/${course.id.replace(/\.mdx?$/, '')}/`} class="hover:underline decoration-2 underline-offset-2 decoration-secondary">{course.data.title}</a>
                  </h3>
                  <p class="mb-6 text-base leading-relaxed flex-grow" style="color: var(--color-on-surface-variant); font-family: var(--font-body);">{course.data.description}</p>
                </div>
                <div class="px-8 py-4 border-t flex items-center justify-between" style="border-color: color-mix(in srgb, var(--color-outline-variant) 50%, transparent);">
                  <a href={`/kuliah/${course.id.replace(/\.mdx?$/, '')}/`} class="link-arrow text-sm group">
                    {(course.data.terms[0]?.meetings.length ?? 0)} sessions
                    <span class="material-symbols-outlined text-lg ml-1 group-hover:translate-x-1 transition-transform">arrow_outward</span>
                  </a>
                </div>
              </article>
            ))}
          </div>
          <div class="mt-12">
            <a href="/kuliah/" class="btn-secondary px-8 py-3.5">All course materials →</a>
          </div>
        </div>
      </section>
    )}

    <!-- Engineering -->
    <section id="engineering" class="bg-background py-section-gap" style="background: var(--color-surface);">
      <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
        <div class="mb-12">
          <h2 class="section-title">Enterprise Software Engineering</h2>
          <span class="tag-green-pill inline-flex items-center gap-2 px-3 py-1">
            <span class="font-display text-xs font-medium">5+ Years Software Engineer at PT Alfath Teknologi Kreatif (Kelola.net) — Clinic Management SaaS (2021–Present)</span>
          </span>
          <p class="section-desc mt-4">Full-stack contributions across <strong>9 major workstreams</strong> — <strong>646 commits</strong>, 10.252 files touched, 204 controller files, 36 models, 646 views, serving hundreds of clinics across Indonesia.</p>
        </div>

        <!-- Git Stats Bar -->
        <div class="mb-12 grid grid-cols-2 md:grid-cols-6 gap-4">
          <div class="border rounded-xl p-4 text-center" style="background: var(--color-surface-container-lowest); border-color: var(--color-outline-variant);">
            <div class="font-display text-2xl font-bold" style="color: var(--color-secondary);">646</div>
            <div class="text-xs mt-1" style="color: var(--color-on-surface-variant);">Total Commits</div>
          </div>
          <div class="border rounded-xl p-4 text-center" style="background: var(--color-surface-container-lowest); border-color: var(--color-outline-variant);">
            <div class="font-display text-2xl font-bold" style="color: var(--color-secondary);">444</div>
            <div class="text-xs mt-1" style="color: var(--color-on-surface-variant);">Non-Merge</div>
          </div>
          <div class="border rounded-xl p-4 text-center" style="background: var(--color-surface-container-lowest); border-color: var(--color-outline-variant);">
            <div class="font-display text-2xl font-bold" style="color: var(--color-secondary);">10.252</div>
            <div class="text-xs mt-1" style="color: var(--color-on-surface-variant);">Files Touched</div>
          </div>
          <div class="border rounded-xl p-4 text-center" style="background: var(--color-surface-container-lowest); border-color: var(--color-outline-variant);">
            <div class="font-display text-2xl font-bold" style="color: var(--color-secondary);">204</div>
            <div class="text-xs mt-1" style="color: var(--color-on-surface-variant);">Controller</div>
          </div>
          <div class="border rounded-xl p-4 text-center" style="background: var(--color-surface-container-lowest); border-color: var(--color-outline-variant);">
            <div class="font-display text-2xl font-bold" style="color: var(--color-secondary);">36</div>
            <div class="text-xs mt-1" style="color: var(--color-on-surface-variant);">Model</div>
          </div>
          <div class="border rounded-xl p-4 text-center" style="background: var(--color-surface-container-lowest); border-color: var(--color-outline-variant);">
            <div class="font-display text-2xl font-bold" style="color: var(--color-secondary);">7</div>
            <div class="text-xs mt-1" style="color: var(--color-on-surface-variant);">DB Migrations</div>
          </div>
        </div>

        <!-- Yearly Timeline -->
        <div class="mb-12 border rounded-xl p-6" style="background: var(--color-surface-container-lowest); border-color: var(--color-outline-variant);">
          <h3 class="font-display text-lg font-semibold mb-4" style="color: var(--color-primary);">Commit Activity by Year</h3>
          <div class="flex flex-col md:flex-row gap-4">
            {[
              { year: '2021', commits: 125, focus: 'Foundation: WA notif, auth/OTP, financial reports, booking, dashboard' },
              { year: '2022', commits: 40, focus: 'Clinic reports, WA API, fullcalendar, rates, per-role dashboard' },
              { year: '2023', commits: 84, focus: 'SATUSEHAT integration (IHS, encounter, SDMK), server-side DataTable' },
              { year: '2024', commits: 104, focus: 'PHP 8.1 migration, Dompdf upgrade, ICD-9 mapping, SATUSEHAT hardening' },
              { year: '2025', commits: 61, focus: 'GrupE shared clinic, health dept reports, ICD-9 checkout, bug fixes' },
              { year: '2026', commits: 30, focus: 'CRM module + model, Docker setup, WA template engine, base salary' },
            ].map((y) => (
              <div class="flex-1 border-l md:border-l-0 md:border-t-2 p-3" style="border-color: var(--color-secondary);">
                <div class="font-display text-lg font-bold" style="color: var(--color-secondary);">{y.year}</div>
                <div class="text-lg font-bold" style="color: var(--color-primary);">{y.commits}</div>
                <div class="text-xs mt-1" style="color: var(--color-on-surface-variant);">{y.focus}</div>
              </div>
            ))}
          </div>
        </div>

        <div class="flex flex-col gap-8">
          {[
            { tag: 'Healthcare Interoperability / API Integration · ~34 commits · Aug 2023–May 2025', title: 'SATUSEHAT Integration — National Health Data Platform', link: '/blog/satusehat-integration', desc: "Integrated the clinic system with SATUSEHAT (Satusehat.php, 377 lines, 2 models), the Indonesian Ministry of Health's national health data exchange platform — separate database (newsatusehat) for logs and tokens, enabling hundreds of clinics to submit electronic medical records to the national system.", items: ['REST API client for SATUSEHAT endpoints (auth OAuth2, CRUD pasien, practitioner, organization, location)', 'Patient IHS lookup & registration with duplicate detection, no-IHS-not-found handling, error recovery', 'SDMK practitioner (doctor, nurse) verification to national SDMK database', 'Organization & Location — facility and practice room registration via API; configurable staging/production environment', 'RME encounter submission with ICD-10 diagnosis and ICD-9 procedures', 'ICD-9 procedure code mapping for clinic actions; checkout dokter with ICD-9 codes', 'Logging & error tracking with dedicated log tables, per-transaction error detail, resend queue for failed submissions', 'Configurable SATUSEHAT key per tenant from admin panel (not hardcoded)', 'Menu per role — SATUSEHAT available in clinic, doctor, admin dashboards with different context'], tags: ['REST API', 'OAuth2', 'JSON', 'ICD-10', 'ICD-9', 'FHIR'] },
            { tag: 'Automation System / CRM · ~28 commits · May 2021–Jul 2026', title: 'WhatsApp Notification & CRM System', link: '/blog/whatsapp-notification-crm', desc: 'End-to-end WhatsApp notification system (WorkerNotif.php, ModelUtama.php 2.488 lines) for appointment reminders, birthday greetings, OTP login, and invoice delivery — spanning legacy cron architecture (WorkerNotif.php, 2021–2025) and a modern CRM module (2026).', items: ['Legacy cron-based delivery: H-1 reminders, same-day reminders, birthday greetings, daily clinic reports per doctor', 'CRM module with device management (CRUD via StarSender new API, QR scan display, status polling AJAX, logout)', 'Template engine — 4 trigger types (H-1, Same-Day, Birthday, Invoice) with dynamic variables: {nama}, {hari}, {tanggal}, {jam}, {dokter}, {invoice}, {nominal}', "CRM_model — centralized DB queries: get_device(), upsert_device(), delete_device(), update_device_status(), get_template(), upsert_template(), is_valid_trigger_id()", 'Rate limiting — 8s minimum poll interval per user via session cooldown', 'WhatsApp OTP for two-factor authentication on new device login; device trusted cookie', 'Webhook-based WhatsApp bot for admin commands (Helpme.php)', 'Bulk save ("Simpan Semua") via sequential AJAX; test send to owner number; toggle all without changing content', 'Critical bug fixes: undefined variable on API failure, foreach null, variable scope, empty trigger type, API key duplication'], tags: ['PHP', 'JavaScript', 'WhatsApp API', 'StarSender', 'AJAX', 'CRON'] },
