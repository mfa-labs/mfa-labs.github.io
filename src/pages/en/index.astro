---
// Stub redirect. Sebelumnya versi Inggris tinggal di /en/; sekarang Inggris
// ada di root "/" dan Indonesia di "/id/". GitHub Pages tidak bisa 301,
// jadi redirect dilakukan di klien sambil tetap menunjuk canonical ke root.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="refresh" content="0; url=/" />
    <title>Redirecting — Muhammad Fadhil Al Amal</title>
    <link rel="canonical" href="https://mfa-labs.github.io/" />
    <meta name="robots" content="noindex, follow" />
    <script is:inline>
      window.location.replace('/');
    </script>
  </head>
  <body>
    <p>
      This page has moved to <a href="/">mfa-labs.github.io</a>. Bahasa Indonesia ada di
      <a href="/id/">/id/</a>.
    </p>
  </body>
</html>
