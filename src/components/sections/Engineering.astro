---
import SectionHeading from '../SectionHeading.astro';
import { gitStats, impactMetrics, timeline, workstreams } from '../../data/engineering';
import { localePath, pick, type Bilingual, type Lang } from '../../lib/i18n';

export interface Props {
  lang: Lang;
  variant?: 'teaser' | 'full';
}

const { lang, variant = 'teaser' } = Astro.props;
const isFull = variant === 'full';

function t<T>(pair: Bilingual<T>): T {
  return pick(pair, lang);
}

const shown = isFull ? workstreams : workstreams.filter((w) => w.featured);

const copy = {
  title: { en: 'Enterprise Software Engineering', id: 'Rekayasa Perangkat Lunak Enterprise' },
  badge: {
    en: '5+ years as Software Engineer at PT Alfath Teknologi Kreatif — clinic management SaaS (2021–Present)',
    id: '5+ tahun Software Engineer di PT Alfath Teknologi Kreatif — SaaS manajemen klinik (2021–Sekarang)',
  },
  desc: {
    en: 'Selected workstreams from a production healthcare SaaS serving hundreds of clinics across Indonesia.',
    id: 'Workstream terpilih dari SaaS kesehatan produksi yang melayani ratusan klinik di Indonesia.',
  },
  descFull: {
    en: 'Full-stack contributions across 9 major workstreams, with 646 commits touching 10.252 files over five years.',
    id: 'Kontribusi full-stack di 9 workstream utama, dengan 646 komit yang menyentuh 10.252 file selama lima tahun.',
  },
  metricsTitle: { en: 'Impact', id: 'Dampak' },
  commitsTitle: { en: 'Commit Activity by Year', id: 'Aktivitas Komit per Tahun' },
  caseStudy: { en: 'Read case study', id: 'Baca studi kasus' },
  seeAll: { en: 'View Engineering Case Studies', id: 'Lihat Studi Kasus Engineering' },
};
---

<section
  id="engineering"
  class="py-section-gap border-t"
  style="background: var(--color-surface-container-lowest); border-color: var(--color-outline-variant);"
>
  <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
    <SectionHeading title={t(copy.title)} desc={isFull ? t(copy.descFull) : t(copy.desc)} />

    <span class="tag-green-pill inline-flex items-center gap-2 px-3 py-1 mb-12">
      <span class="font-display text-xs font-medium">{t(copy.badge)}</span>
    </span>

    {
      !isFull && (
        <div class="mb-12 grid grid-cols-2 md:grid-cols-5 gap-4">
          {impactMetrics.map((m) => (
            <div
              class="border rounded-xl p-4 text-center transition-all duration-200 hover:-translate-y-0.5 hover:shadow-ambient"
              style="background: var(--color-surface-container-low); border-color: var(--color-outline-variant);"
            >
              <div class="font-display text-lg font-bold" style="color: var(--color-secondary);">
                {m.value}
              </div>
              <div class="text-xs mt-1" style="color: var(--color-on-surface-variant);">
                {m[lang]}
              </div>
            </div>
          ))}
        </div>
      )
    }

    {
      isFull && (
        <>
          <div class="mb-12 grid grid-cols-2 md:grid-cols-6 gap-4">
            {gitStats.map((s) => (
              <div
                class="border rounded-xl p-4 text-center"
                style="background: var(--color-surface-container-low); border-color: var(--color-outline-variant);"
              >
                <div class="font-display text-2xl font-bold" style="color: var(--color-secondary);">
                  {s.value}
                </div>
                <div class="text-xs mt-1" style="color: var(--color-on-surface-variant);">
                  {s[lang]}
                </div>
              </div>
            ))}
          </div>

          <div
            class="mb-12 border rounded-xl p-6"
            style="background: var(--color-surface-container-low); border-color: var(--color-outline-variant);"
          >
            <h3 class="font-display text-lg font-semibold mb-4" style="color: var(--color-primary);">
              {t(copy.commitsTitle)}
            </h3>
            <div class="flex flex-col md:flex-row gap-4">
              {timeline.map((y) => (
                <div
                  class="flex-1 border-l md:border-l-0 md:border-t-2 p-3"
                  style="border-color: var(--color-secondary);"
                >
                  <div class="font-display text-lg font-bold" style="color: var(--color-secondary);">
                    {y.year}
                  </div>
                  <div class="text-lg font-bold" style="color: var(--color-primary);">{y.commits}</div>
                  <div class="text-xs mt-1" style="color: var(--color-on-surface-variant);">
                    {y[lang]}
                  </div>
                </div>
              ))}
            </div>
          </div>
        </>
      )
    }

    <div class="flex flex-col gap-8">
      {
        shown.map((w) => (
          <article
            class="flex flex-col border rounded-xl overflow-hidden transition-all duration-300 hover:-translate-y-0.5 hover:shadow-ambient"
            style="background: var(--color-surface-container-low); border-color: var(--color-outline-variant);"
          >
            <div class="p-6 md:p-8 flex-grow">
              <span class="tag-project mb-4 inline-block">{t(w.tag)}</span>
              <h3 class="font-display text-xl mb-3 mt-3" style="color: var(--color-primary);">
                {t(w.title)}
              </h3>
              <p class="mb-4" style="color: var(--color-on-surface-variant); font-family: var(--font-body);">
                {t(w.desc)}
              </p>
              <ul
                class="space-y-1 text-sm list-disc pl-4 mb-6 max-w-[70ch]"
                style="color: var(--color-on-surface-variant); font-family: var(--font-body);"
              >
                {t(w.items).map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
              {w.link && (
                <a href={w.link} class="link-arrow text-sm group">
                  {t(copy.caseStudy)}: {t(w.title)}
                  <span class="material-symbols-outlined text-lg ml-1 group-hover:translate-x-1 transition-transform">
                    arrow_outward
                  </span>
                </a>
              )}
            </div>
            <div
              class="px-6 md:px-8 py-4 border-t flex flex-wrap gap-2"
              style="border-color: color-mix(in srgb, var(--color-outline-variant) 50%, transparent);"
            >
              {w.tags.map((tag) => (
                <span class="tag-eng">{tag}</span>
              ))}
            </div>
          </article>
        ))
      }
    </div>

    {
      !isFull && (
        <div class="mt-12">
          <a href={localePath('/engineering/', lang)} class="btn-secondary px-8 py-3.5">
            {t(copy.seeAll)} →
          </a>
        </div>
      )
    }
  </div>
</section>
