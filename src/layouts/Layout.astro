---
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  lang?: 'en' | 'id';
  alternateUrl?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = 'Muhammad Fadhil Al Amal — AI & Software Engineer | NLP Researcher',
  ogImage = '/cropped_circle_image.png',
  ogType = 'website',
  lang = 'en',
  alternateUrl = undefined,
  noindex = false,
  jsonLd = undefined,
} = Astro.props;

const site = Astro.site ?? new URL('https://mfa-labs.github.io');
const canonicalUrl = new URL(Astro.url.pathname, site).href;
const ogImageUrl = new URL(ogImage, site).href;
const alternateHref = alternateUrl ? new URL(alternateUrl, site).href : undefined;
const rootUrl = new URL('/', site).href;
const ogLocale = lang === 'en' ? 'en_US' : 'id_ID';
const alternateLocale = lang === 'en' ? 'id_ID' : 'en_US';

const siteTitle = title.includes('Muhammad Fadhil')
  ? title
  : `${title} — Muhammad Fadhil Al Amal`;
---

<!doctype html>
<html lang={lang} class="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{siteTitle}</title>
  <meta name="description" content={description} />
  <meta name="author" content="Muhammad Fadhil Al Amal" />
  {noindex && <meta name="robots" content="noindex" />}

  <!-- Icons -->
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/favicon.png" />

  <!-- Canonical & Language Alternates -->
  {!noindex && <link rel="canonical" href={canonicalUrl} />}
  {
    alternateHref && (
      <>
        <link rel="alternate" hreflang={lang} href={canonicalUrl} />
        <link rel="alternate" hreflang={lang === 'en' ? 'id' : 'en'} href={alternateHref} />
        <link rel="alternate" hreflang="x-default" href={rootUrl} />
      </>
    )
  }

  <!-- Open Graph -->
  <meta property="og:locale" content={ogLocale} />
  {alternateHref && <meta property="og:locale:alternate" content={alternateLocale} />}
  <meta property="og:title" content={siteTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:alt" content="Muhammad Fadhil Al Amal" />
  <meta property="og:site_name" content="Muhammad Fadhil Al Amal" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={siteTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />
  <meta name="twitter:image:alt" content="Muhammad Fadhil Al Amal" />

  <!-- JSON-LD Schema -->
  {
    jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )
  }

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Inter:wght@400;500&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />

  <!-- RSS -->
  <link rel="alternate" type="application/rss+xml" title="Muhammad Fadhil Al Amal — Technical Blog" href="/rss.xml" />
</head>
<body>
  <slot />
  <script>
    // Dark mode toggle logic
    const stored = localStorage.getItem('theme');
    if (stored === 'dark') {
      document.documentElement.classList.remove('light');
      document.documentElement.classList.add('dark');
    }
  </script>
</body>
</html>
